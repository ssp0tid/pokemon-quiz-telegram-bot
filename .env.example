# Telegram API ID and Hash (get from my.telegram.org)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here

# Bot Settings
# For User Account Mode: Leave BOT_TOKEN empty
# For Bot Mode: Set BOT_TOKEN with your bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Quiz Settings
QUIZ_QUESTION_TIMEOUT=30
QUIZ_QUESTIONS_PER_SESSION=10
QUIZ_POINTS_CORRECT=10
QUIZ_POINTS_TIME_BONUS=5
QUIZ_HINTS_ALLOWED=2
